# Copy this file to ".env" and fill in what you need.
PORT=3000
# Keep times consistent with your restaurant (daily order numbers reset at local midnight):
TZ=Asia/Kolkata

# WhatsApp Cloud API (Meta). Leave empty to disable automatic messages.
# The "Chat on WhatsApp" buttons in the UI work without these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional: choose the first-time passwords yourself (otherwise random ones are printed on first run)
# ADMIN_PASSWORD=
# KITCHEN_PASSWORD=

# Integrations: allow status callbacks to private/LAN addresses (default: blocked)
# ALLOW_PRIVATE_CALLBACKS=1
